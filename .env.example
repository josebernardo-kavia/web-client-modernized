# Base URL for the modernized REST API (FastAPI). Example:
# VITE_API_BASE=http://localhost:3002
VITE_API_BASE=

# OIDC / Keycloak configuration (Authorization Code Flow + PKCE)
# Example issuer:
# VITE_OIDC_ISSUER=http://localhost:8080/realms/<your-realm>
VITE_OIDC_ISSUER=

# OIDC client id registered in Keycloak
VITE_OIDC_CLIENT_ID=

# Redirect URI registered in the OIDC client. Must match the SPA callback route.
# Example:
# VITE_OIDC_REDIRECT_URI=http://localhost:3003/oidc/callback
VITE_OIDC_REDIRECT_URI=

# Requested scope. Must include "openid". Typically also include "profile email offline_access".
# Example:
# VITE_OIDC_SCOPE=openid profile email offline_access
VITE_OIDC_SCOPE=

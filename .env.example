# ------------------------------
# Web Client (Vite) Environment
# ------------------------------
# Notes:
# - Only variables prefixed with VITE_ are exposed to the browser by Vite.
# - Defaults below match the preview/dev ports:
#   - Backend:  http://localhost:3002
#   - Frontend: http://localhost:3003
#
# Copy this file to `.env` and adjust as needed.

# Base URL for the modernized REST API (FastAPI).
# Used by src/api/client.ts via import.meta.env.VITE_API_BASE
VITE_API_BASE=http://localhost:3002

# Optional: explicit URLs for cross-container linking (not required by code today).
# Keep these in sync with the ports above if you use them in custom integrations.
VITE_BACKEND_URL=http://localhost:3002
VITE_FRONTEND_URL=http://localhost:3003

# Optional: WebSocket base URL (if/when realtime features are added).
# Example: ws://localhost:3002/ws
VITE_WS_URL=

# Optional: Node environment label for frontend build logic.
VITE_NODE_ENV=development

# Optional: disable telemetry for Next.js (not used by this app, but kept for container parity).
VITE_NEXT_TELEMETRY_DISABLED=1

# Optional: enable source maps in build output (useful for debugging in preview).
VITE_ENABLE_SOURCE_MAPS=1

# Optional: dev server port (the npm script already sets --port 3003; this is for documentation parity).
VITE_PORT=3003

# ------------------------------
# OIDC / Keycloak configuration
# ------------------------------
# The app uses Authorization Code Flow + PKCE.
# These are REQUIRED for real login flows (see src/services/authService.ts).

# Example issuer (Keycloak):
# VITE_OIDC_ISSUER=http://localhost:8080/realms/<your-realm>
VITE_OIDC_ISSUER=

# OIDC client id registered in Keycloak for the SPA
VITE_OIDC_CLIENT_ID=

# Redirect URI registered in the OIDC client.
# Must match the SPA callback route `/oidc/callback`.
VITE_OIDC_REDIRECT_URI=http://localhost:3003/oidc/callback

# Requested scope. Must include "openid".
# For Keycloak refresh tokens, include "offline_access" and enable the client accordingly.
VITE_OIDC_SCOPE=openid profile email offline_access
